{
  "name": "obsidian",
  "version": "0.1.0",
  "description": "OBSIDIAN — Creative Director's Workflow Engine. Node-based visual automation for creative production with AI Bridge record/replay.",
  "main": "out/main/index.js",
  "author": "Vũ Tiến Minh",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac",
    "postinstall": "playwright install chromium || true"
  },
  "dependencies": {
    "@reactflow/core": "^11.10.4",
    "playwright": "^1.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "vite": "^5.3.3"
  },
  "build": {
    "appId": "studio.obsidian.creative",
    "productName": "OBSIDIAN",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
